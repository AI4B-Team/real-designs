{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  "exclude": ["src/content/rd-reveal.ts", "src/content/rd-app-script.ts", "src/content/rd-present.ts", "src/content/rd-shop.ts", "src/content/rd-explore.ts", "src/content/rd-reports.ts", "src/content/rd-media-lib.ts", "src/content/rd-photo-editor.ts", "src/content/rd-propmedia.ts", "src/content/rd-site-script.ts", "src/content/rd-site-extra.ts", "src/content/rd-showcase.ts", "src/content/rd-style-admin.ts", "src/lib/media-library.ts", "src/lib/rd-bulk-restyle.ts", "src/lib/rd-vfx-looks.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
